# yt-trend-radar — 환경변수 템플릿
# 실제 값은 .env 에만 넣는다 (.gitignore 처리됨). 절대 커밋하지 않는다.
# GitHub Actions 에서는 Secrets 로 주입한다.

# --- 동작 모드 ---
# harness: 외부 호출 없음 (fixtures/메모리). live: 실제 API/DB 호출.
YT_MODE=harness
DB_MODE=harness

# --- YouTube Data API v3 ---
# Google Cloud Console → APIs & Services → Credentials → API key
# 일 쿼터 10,000 units. 수집기(서버)에서만 사용 — 브라우저에 노출 금지.
YT_API_KEY=
# search.list 일 예산 (100 units/회). 0 이면 발굴 비활성.
YT_SEARCH_BUDGET_CALLS=60
# 일 전체 쿼터 상한 (안전 마진 포함)
YT_DAILY_QUOTA_LIMIT=9500

# --- Supabase ---
SUPABASE_URL=
# 수집기 전용 — 쓰기 권한. Actions Secrets 에만 둔다.
SUPABASE_SERVICE_KEY=
# 웹 전용 — RLS read-only. web/.env.local 의 NEXT_PUBLIC_* 로 사용.
SUPABASE_ANON_KEY=

# --- 트렌드 지수 파라미터 (SPEC FR-7) ---
# score = Δviews / (Δhours * max(subscribers, floor)^alpha)
# ⚠️ TREND_ALPHA_RISING 은 1.0 이상이어야 한다.
#    Δ가 구독자에 비례할 때 score ∝ 구독자^(1-α) 이므로, α<1 이면 '신규 뜨는' 보드가
#    구독자 규모 순으로 되돌아간다 (2026-08-03 실증). 1.0 미만은 기동 시 예외로 막힌다.
TREND_ALPHA_TRENDING=0.25
TREND_ALPHA_RISING=1.00
TREND_SUBSCRIBER_FLOOR=1000
# "신규 뜨는 유튜버" 구독자 상한 (SPEC D7)
RISING_SUBSCRIBER_MAX=100000

# --- 보관 정책 (YouTube ToS: 30일) ---
RETENTION_DAYS=30
